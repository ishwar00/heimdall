#!/usr/bin/python3
"""Adds ThreadIsland's hook (ti-event) to Claude Code (~/.claude/settings.json) and Codex (~/.codex/hooks.json);
`install --remove` takes it out again. Your other hooks and settings are kept; running it twice adds nothing.
The first run keeps a copy of each file next to it as <file>.threadisland-backup.

Hook formats: https://code.claude.com/docs/en/hooks and https://developers.openai.com/codex/hooks
Codex asks once ("Review hooks") before it runs a new user-level hook: allow it there."""
import json
import os
import shlex
import shutil
import sys

HOOK = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'ti-event')
# per turn only, nothing per tool call: the hook starts Python each time
EVENTS = {'claude': ['UserPromptSubmit', 'Notification', 'Stop', 'SessionEnd'],
          'codex': ['UserPromptSubmit', 'PermissionRequest', 'Stop', 'Interrupt', 'SessionEnd']}
FILES = {'claude': '~/.claude/settings.json', 'codex': '~/.codex/hooks.json'}


def ours(hook):
    return HOOK in str(hook.get('command', ''))


def update(tool, add):
    path = os.path.expanduser(FILES[tool])
    try:
        with open(path) as fh:
            config = json.load(fh)
    except FileNotFoundError:
        config = {}
    hooks = config.setdefault('hooks', {})
    installed = any(ours(h) for groups in hooks.values() for g in groups for h in g.get('hooks', []))
    # your own file, as it was before the first install (one that has our hook in it was written here)
    if os.path.exists(path) and not installed and not os.path.exists(path + '.threadisland-backup'):
        shutil.copy2(path, path + '.threadisland-backup')
    for event in list(hooks):  # drop ours, keep everything else
        groups = []
        for group in hooks[event]:
            kept = [h for h in group.get('hooks', []) if not ours(h)]
            if kept or not group.get('hooks'):
                groups.append(dict(group, hooks=kept))
        if groups:
            hooks[event] = groups
        else:
            del hooks[event]
    if add:
        command = f'{shlex.quote(HOOK)} {tool}'
        for event in EVENTS[tool]:
            hooks.setdefault(event, []).append({'hooks': [{'type': 'command', 'command': command, 'timeout': 5}]})
    if not hooks:
        del config['hooks']
    if not config and not add and not os.path.exists(path + '.threadisland-backup'):
        os.remove(path)  # install created it and nothing else is in it
        print(f'removed {FILES[tool]}')
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + '.tmp', 'w') as fh:
        json.dump(config, fh, indent=2)
        fh.write('\n')
    os.replace(path + '.tmp', path)
    print(f"{'added to' if add else 'removed from'} {FILES[tool]}")


if __name__ == '__main__':
    for tool in FILES:
        update(tool, '--remove' not in sys.argv)
