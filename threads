#!/usr/bin/env python3
"""threads: Codex + Claude Code threads, recency-sorted, as JSON for the ThreadIsland notch app.

Sources: Codex desktop/CLI (~/.codex/state_*.sqlite), Claude desktop Code tab
(claude-code-sessions/*.json), Claude CLI background jobs (~/.claude/jobs) and
live interactive Claude CLI sessions (~/.claude/sessions).
Jumps: codex:// and claude:// deep links, Ghostty AppleScript (focus tab by tty,
or open a new window running the resume command). `--jump` reads one row's JSON on stdin.
"""
import contextlib
import ipaddress
import socket
import datetime
import fcntl
import glob
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

HOME = os.path.expanduser('~')
WINDOW_DAYS = 7
NOW = time.time()
TODAY = datetime.date.today()
# Same window as Codex's activity view: today plus the previous 6 local days
CUTOFF = time.mktime((TODAY - datetime.timedelta(days=WINDOW_DAYS - 1)).timetuple())
# A thread is in Priority while it has had activity in the last 2 h; 2 h without any activity ends its run
IDLE_OUT = 2 * 3600
# one bad record (a transcript that vanished, a file mid-write) is reported here and skipped, not the whole source
ERRORS = []


def run(cmd, stdin=None, timeout=10):
    try:
        return subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ''


def ago(ts):
    s = max(0, NOW - ts)
    for unit, n in (('d', 86400), ('h', 3600), ('m', 60)):
        if s >= n:
            return f'{int(s // n)}{unit}'
    return 'now'


def ghostty_ttys():
    if not run(['pgrep', '-x', 'ghostty']):
        return set()
    out = run(['osascript', '-e', 'tell application "Ghostty" to get tty of every terminal'])
    return {t.strip() for t in out.split(',') if t.strip()}


WARP_EXE = re.compile(r'^\S*/Warp\.app/Contents/MacOS/')


def focus_target(p, gtty, by_pid):
    """(action, arg) that focuses the terminal a live session runs in: its Ghostty terminal by TTY, else its
    Warp tab via the WARP_FOCUS_URL Warp exports to every session (warpdotdev/warp PR #11130), else None."""
    if p['tty'] in gtty:
        return 'focus', p['tty']
    # The URL is inherited by everything a Warp tab starts, including Claude's background-job daemon and its
    # workers (which get their own TTYs), so trust it only when a Warp executable is an ancestor of the session.
    a, hops = by_pid.get(p['ppid']), 0
    while a and not WARP_EXE.match(a['args']) and hops < 30:
        a, hops = by_pid.get(a['ppid']), hops + 1
    if a:
        for tok in run(['ps', 'eww', '-o', 'command=', '-p', str(p['pid'])], timeout=3).split():
            if tok.startswith('WARP_FOCUS_URL=warp://session/'):
                return 'url', tok.split('=', 1)[1]
    return None


def processes():
    rows = []
    for line in run(['ps', '-axo', 'pid=,ppid=,tty=,args=']).splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4:
            rows.append({'pid': int(parts[0]), 'ppid': int(parts[1]), 'tty': '/dev/' + parts[2], 'args': parts[3]})
    return rows


def row(key, ts, src, state, title, detail, action, arg, cwd=''):
    # key is stable across refreshes (thread/job/session id); ts is your last message (day sections sort on
    # it); each source then sets 'active' (last activity), 'entered' (start of the current run) and 'created'
    return {'key': key, 'ts': ts, 'src': src, 'state': state, 'title': title, 'detail': detail,
            'action': action, 'arg': arg, 'cwd': cwd}


def plain(md):
    """One-line Markdown as plain text: [label](url) -> label, drop ** and backticks."""
    return re.sub(r'\[([^\]]+)\]\([^)]*\)', r'\1', md).replace('**', '').replace('`', '')


def lines_back(path, chunk=256 * 1024):
    """Lines of a file, newest first, read from the end in chunks that double up to 4 MB: most answers are
    in the last few hundred KB. Memory is a chunk plus the longest line."""
    with open(path, 'rb') as fh:
        pos, carry = os.path.getsize(path), b''
        while pos > 0:
            n = min(chunk, pos)
            chunk = min(chunk * 2, 4 * 1024 * 1024)
            pos -= n
            fh.seek(pos)
            lines = (fh.read(n) + carry).split(b'\n')
            carry = lines.pop(0) if pos > 0 else b''  # may continue in the previous chunk
            for line in reversed(lines):
                if line:
                    yield line


def line_time(line, last):
    """A log line's timestamp without decoding the line: Codex puts it first, Claude after the message."""
    i = line.rfind(b'"timestamp":"') if last else line.find(b'"timestamp":"')
    if i < 0:
        return None
    try:
        return epoch(line[i + 13:line.find(b'"', i + 13)].decode())
    except ValueError:
        return None


def is_activity(line, claude):
    """Conversation records only: not the bookkeeping both tools write into idle threads (Claude's system
    notices and bridge records, Codex's settings sync when the app loads a thread)."""
    if claude:
        return b'"type":"user"' in line or b'"type":"assistant"' in line
    return (b'"type":"response_item"' in line or b'"type":"event_msg"' in line) and b'"thread_settings_applied"' not in line


def loads(line):
    try:
        return json.loads(line)
    except ValueError:
        return {}


def scan_log(kind, path, sent=False, title=False):
    """Read a Codex rollout or Claude transcript backwards, only as far as needed, for:
    active  - its newest entry;
    entered - the start of its current run of activity (the oldest entry with no IDLE_OUT gap after it),
              only while the thread is in Priority; the same rule that puts it there, so a long turn or a
              long wait on you can't reorder Priority without the thread leaving it;
    turn    - Codex: its latest turn event; sent, title - Claude, when asked: your last message, its name;
    asked   - Codex: the question it asked you (request_user_input) if you haven't answered since."""
    out = {}
    claude = kind == 'claude'
    need_run, need_sent, need_title, need_turn, need_ask = True, sent, title, not claude, not claude
    run_start = ai = None
    scanned = 0
    turn_times = []  # Codex: activity times newer than the last task_started seen, kept until we know who started it

    def feed(t):
        nonlocal need_run, run_start
        if 'active' not in out:
            out['active'] = t
            need_run = NOW - t < IDLE_OUT
        elif run_start - t >= IDLE_OUT:
            out['entered'], need_run = run_start, False
        run_start = t if need_run else run_start

    for line in lines_back(path):
        scanned += len(line) + 1
        if need_run and is_activity(line, claude):
            t = line_time(line, claude)
            if t is not None:
                if claude:
                    feed(t)
                else:
                    turn_times.append(t)
        if need_run and not claude and b'"task_started"' in line:
            payload = loads(line).get('payload') or {}
            trigger = (payload.get('turn_attribution') or {}).get('turn_trigger') or ''
            # a scheduled automation turn runs on its own, sometimes for hours; it isn't you working on the thread
            for t in ([] if trigger.startswith('automation') else turn_times):
                if need_run:
                    feed(t)
            turn_times = []
        if need_sent and b'"kind":"human"' in line:
            rec = loads(line)
            if rec.get('type') == 'user' and (rec.get('origin') or {}).get('kind') == 'human':
                out['sent'], need_sent = epoch(rec['timestamp']), False
        if need_title:
            if b'"type":"custom-title"' in line:
                out['title'], need_title = loads(line).get('customTitle'), False
            elif ai is None and b'"type":"ai-title"' in line:
                ai = loads(line).get('aiTitle')
            if scanned > 8 * 1024 * 1024:  # renames are re-logged often; an older one isn't the latest
                need_title = False
        if need_turn and (b'"task_' in line or b'"turn_aborted"' in line):
            payload = loads(line).get('payload') or {}
            if payload.get('type') in ('task_started', 'task_complete', 'turn_aborted'):
                out['turn'], need_turn = payload, False
        if need_ask and b'"type":"UserMessage"' in line:  # your message or answer; anything older is answered
            need_ask = False
        elif need_ask and b'"name":"request_user_input' in line:  # also listed in tool definitions
            payload = loads(line).get('payload') or {}
            if payload.get('type') == 'function_call':
                try:
                    questions = json.loads(payload.get('arguments') or '{}').get('questions') or [{}]
                except ValueError:
                    questions = [{}]
                out['asked'], need_ask = plain(questions[0].get('title') or questions[0].get('question') or '') or 'Asked you a question', False
        if not (need_run or need_sent or need_title or need_turn or need_ask):
            break
    for t in turn_times:  # before the first turn started
        if need_run:
            feed(t)
    if need_run and run_start is not None:  # the run reaches back to the first entry
        out['entered'] = run_start
    if not out.get('title'):
        out['title'] = ai
    return out


def codex_turn(turn, rollout, asked=None):
    """(state, last reply) from a Codex rollout's latest turn event: a started turn that is still being
    written is working; task_complete carries the reply shown in Codex's sidebar. An unanswered question
    wins: the agent keeps polling while it waits for your answer, which would otherwise read as working."""
    if asked:
        return 'needs you', asked
    kind = (turn or {}).get('type')
    if kind == 'task_started':
        # Codex writes nothing while a turn waits on approval or hangs, so only a fresh write counts as working
        return ('working' if NOW - os.path.getmtime(rollout) < 600 else ''), None
    if kind == 'task_complete':
        return '', plain((turn.get('last_agent_message') or '').strip().split('\n')[0]) or None
    return '', None


def logged(r, log, fallback_active, source=None):
    """Fill a row's activity fields from its log, falling back to the source's own timestamps.
    source: (kind, log path), read again for the PRs the thread created."""
    if source and source[1]:
        r['log'] = source
    # a log with no conversation records in reach has no activity; the source's own times include bookkeeping
    r['active'] = log.get('active', 0) if log else fallback_active
    if log.get('entered'):
        r['entered'] = log['entered']
    return r


def codex_rows(procs, gtty):
    dbs = sorted(glob.glob(f'{HOME}/.codex/state_*.sqlite'),
                 key=lambda p: int(re.search(r'state_(\d+)', p).group(1)))
    if not dbs:
        return []
    # unread: Codex's blue dot, a finished turn you haven't opened yet; cleared when you open the thread
    query = """select id, coalesce(name, title), cwd, source, recency_at_ms, updated_at_ms, created_at_ms, rollout_path,
                      {unread}
               from threads
               where archived = 0 and coalesce(thread_source, 'user') = 'user'
                 and source in ('vscode', 'cli') and recency_at_ms >= ?"""
    receipts = """exists(select 1 from thread_read_receipts r where r.thread_id = threads.id
                                and r.first_unread_turn is not null)"""
    # not mode=ro: a read-only open fails whenever Codex has just checkpointed the WAL to 0 bytes.
    # A normal connection joins WAL locking like any reader; query_only forbids writes from here.
    con = sqlite3.connect(dbs[-1], timeout=2)
    try:
        con.execute('pragma query_only = 1')
        has_receipts = con.execute("select 1 from sqlite_master where name = 'thread_read_receipts'").fetchone()
        found = con.execute(query.format(unread=receipts if has_receipts else '0'), (CUTOFF * 1000,)).fetchall()
    finally:
        con.close()

    # live Codex CLI in a terminal: match the rollout file it holds open
    live, by_pid = {}, {p['pid']: p for p in procs}
    for p in procs:
        if p['tty'] != '/dev/??' and re.search(r'(^|/)codex(\s|$)', p['args']):
            target = None
            for name in run(['lsof', '-p', str(p['pid']), '-Fn'], timeout=3).splitlines():
                if name.startswith('n') and 'rollout-' in name:
                    live[name[1:]] = target = target or focus_target(p, gtty, by_pid)

    rows = []
    for tid, title, cwd, source, rec_ms, upd_ms, created_ms, rollout, unread in found:
        try:
            log = scan_log('codex', rollout) if rollout and os.path.exists(rollout) else {}
            src = 'codex' if source == 'vscode' else 'codex-cli'
            state, reply = codex_turn(log.get('turn'), rollout, log.get('asked')) if log else ('', None)
            if unread and not state:  # finished and not yet read: your turn, like a finished Claude thread
                state = 'needs you'
            detail = reply or os.path.basename(cwd)
            if live.get(rollout):
                r = row(tid, rec_ms / 1000, src, state, title, detail, *live[rollout])
            elif source == 'vscode':
                r = row(tid, rec_ms / 1000, src, state, title, detail, 'url', f'codex://threads/{tid}')
            else:
                r = row(tid, rec_ms / 1000, src, state, title, detail, 'tab', f'codex resume {tid}', cwd)
            r['created'] = (created_ms or rec_ms) / 1000
            rows.append(logged(r, log, (upd_ms or rec_ms) / 1000, ('codex', rollout)))
        except Exception as e:  # noqa: BLE001
            ERRORS.append(f'Codex thread {tid}: {type(e).__name__}: {e}')
    return rows


def claude_desktop_rows(sessions):
    busy = {d.get('sessionId') for d in sessions if d.get('status') == 'busy'}
    rows = []
    pattern = f'{HOME}/Library/Application Support/Claude/claude-code-sessions/*/*/local_*.json'
    for f in glob.glob(pattern):
        try:
            if os.path.getmtime(f) < CUTOFF:  # files are large; mtime >= lastActivityAt, so skip unparsed
                continue
            try:
                d = json.load(open(f))
            except ValueError:  # being rewritten right now; next refresh reads it
                continue
            # your last message, like Codex's recency_at; lastActivityAt moves with every agent step
            ts = (d.get('latestUserFrameAt') or d.get('lastActivityAt') or 0) / 1000
            if d.get('isArchived') or ts < CUTOFF:
                continue
            summary = d.get('postTurnSummary') or {}
            # a turn in progress wins over the previous turn's summary
            state = ('working' if d.get('cliSessionId') in busy
                     else 'needs you' if summary.get('status_category') == 'blocked' else '')
            path = transcript_path(d.get('cliSessionId'))
            log = scan_log('claude', path) if path else {}
            r = row(d['sessionId'], ts, 'claude-app', state, d.get('title') or '(untitled)',
                    summary.get('status_detail') or d.get('cwd', ''),
                    'url', f"claude://code/continue?session={d['sessionId']}")
            r['created'] = (d.get('createdAt') or 0) / 1000
            rows.append(logged(r, log, (d.get('lastActivityAt') or 0) / 1000, ('claude', path)))
        except Exception as e:  # noqa: BLE001
            ERRORS.append(f'Claude app {os.path.basename(f)}: {type(e).__name__}: {e}')
    return rows


def transcript_path(session_id):
    paths = glob.glob(f'{HOME}/.claude/projects/*/{session_id}.jsonl') if session_id else []
    return paths[0] if paths else None


def epoch(iso):
    return datetime.datetime.fromisoformat(iso.replace('Z', '+00:00')).timestamp()


def live_sessions():
    """Claude Code session records whose process is still running."""
    out = []
    for f in glob.glob(f'{HOME}/.claude/sessions/*.json'):
        try:
            d = json.load(open(f))
            os.kill(d['pid'], 0)
        except (OSError, ValueError, KeyError, TypeError):
            continue
        out.append(d)
    return out


def claude_cli_rows(procs, gtty, sessions):
    proc = {p['pid']: p for p in procs}
    attached = {}  # job name/id -> where its `claude attach` runs
    for p in procs:
        m = re.search(r'\bclaude\b.*\battach\s+(\S+)', p['args'])
        if m and p['tty'] != '/dev/??':
            target = focus_target(p, gtty, proc)
            if target:
                attached[m.group(1)] = target

    live, busy_jobs = [], set()
    for d in sessions:
        if d.get('kind') == 'interactive':
            live.append(d)
        elif d.get('jobId') and d.get('status') == 'busy':
            busy_jobs.add(d['jobId'])
    # A window in agent view parks its own session as a job; an unnamed parked job is that empty window, not a thread
    parked = {d['parkedJobId'] for d in live if d.get('parkedJobId')}

    rows, seen = [], set()
    for f in glob.glob(f'{HOME}/.claude/jobs/*/state.json'):
        jid = os.path.basename(os.path.dirname(f))
        try:
            try:
                d = json.load(open(f))
            except ValueError:  # being rewritten right now; next refresh reads it
                continue
            mtime = os.path.getmtime(f)
            if (jid in parked and not d.get('name')) or mtime < CUTOFF:
                continue
            seen.add(d.get('sessionId'))
            path = transcript_path(d.get('sessionId'))
            log = scan_log('claude', path, sent=True) if path else {}
            # state.json lags a reply (stays 'blocked' until the next summary); a busy live session wins, as in `claude agents`
            state = 'working' if jid in busy_jobs else {'blocked': 'needs you'}.get(d.get('state'), d.get('state') or '')
            title = d.get('name') or d.get('displayIntent') or d.get('intent') or jid
            target = next((attached[k] for k in (jid, d.get('name'), d.get('sessionId')) if k in attached), None)
            if target:
                r = row(jid, log.get('sent') or mtime, 'claude-bg', state, title, d.get('detail') or '', *target)
            else:
                r = row(jid, log.get('sent') or mtime, 'claude-bg', state, title, d.get('detail') or '', 'tab',
                        f'claude attach {jid}', d.get('cwd') or HOME)
            r['created'] = epoch(d['createdAt']) if d.get('createdAt') else mtime
            rows.append(logged(r, log, mtime, ('claude', path)))
        except Exception as e:  # noqa: BLE001
            ERRORS.append(f'Claude job {jid}: {type(e).__name__}: {e}')

    for d in live:
        # agent-view windows aren't threads; the jobs they show are listed above
        if d.get('sessionId') in seen or d.get('parkedJobId'):
            continue
        # a headless `claude -p` another agent started (e.g. a review peer) has no window to jump to
        p = proc.get(d['pid'])
        if (d.get('entrypoint') or '').startswith('sdk') and (not p or p['tty'] == '/dev/??'):
            continue
        try:
            path = transcript_path(d['sessionId'])
            log = scan_log('claude', path, sent=True, title=True) if path else {}
            updated = (d.get('updatedAt') or d.get('startedAt') or 0) / 1000
            state = 'working' if d.get('status') == 'busy' else ''
            title = d.get('name') if d.get('nameSource') == 'user' else None
            title = title or log.get('title') or d.get('name') or d['sessionId']
            target = focus_target(proc[d['pid']], gtty, proc) if d['pid'] in proc else None
            # other terminals (Terminal.app, iTerm2, ...) aren't supported yet: the row shows but doesn't jump
            r = row(d['sessionId'], log.get('sent') or updated, 'claude-cli', state, title, d.get('cwd', ''),
                    *(target or ('none', '')))
            r['created'] = (d.get('startedAt') or 0) / 1000
            rows.append(logged(r, log, updated, ('claude', path)))
        except Exception as e:  # noqa: BLE001
            ERRORS.append(f'Claude session {d.get("sessionId")}: {type(e).__name__}: {e}')
    return rows


GHOSTTY_FOCUS = '''on run argv
    tell application "Ghostty"
        focus (first terminal whose tty is (item 1 of argv))
        activate
    end tell
end run'''

GHOSTTY_TAB = '''on run argv
    tell application "Ghostty"
        set cfg to new surface configuration
        set initial working directory of cfg to (item 1 of argv)
        set initial input of cfg to (item 2 of argv) & linefeed
        new window with configuration cfg
        activate
    end tell
end run'''


ARC = 'company.thebrowser.Browser'
# Arc's scripting: https://resources.arc.net/hc/en-us/articles/19212718608151-Arc-for-macOS-AppleScript-API
# fields joined by the unit separator (0x1F), which titles and URLs don't contain
ARC_CAPTURE = '''set d to ASCII character 31
tell application "Arc" to tell front window
    return (id of active tab) & d & (title of active tab) & d & (URL of active tab) & d & (id of active space) & d & (title of active space)
end tell'''
ARC_SELECT = '''on run argv
    tell application "Arc"
        activate
        tell front window
            try
                tell (first space whose id is (item 2 of argv)) to focus
            end try
            try
                tell (first tab whose id is (item 1 of argv)) to select
                return "ok"
            end try
            repeat with s in spaces
                try
                    tell (first tab of s whose id is (item 1 of argv)) to select
                    return "ok"
                end try
            end repeat
            -- Arc can give a tab a new id (after a restart); the same page still open counts
            repeat with s in spaces
                try
                    tell (first tab of s whose URL is (item 3 of argv)) to select
                    return "ok"
                end try
            end repeat
        end tell
    end tell
    return "missing"
end run'''


def front_app():
    """(bundle id, name) of the app you're in; the island never takes that from it."""
    info = run(['lsappinfo', 'info', '-only', 'bundleid', '-only', 'name', run(['lsappinfo', 'front']).strip()])
    bundle = re.search(r'"CFBundleIdentifier"="([^"]*)"', info)
    name = re.search(r'"LSDisplayName"="([^"]*)"', info)
    return (bundle.group(1) if bundle else None), (name.group(1) if name else None)


def capture_page():
    """Where you are right now: the Arc tab you're on, or the app (one window per app in practice)."""
    bundle, name = front_app()
    if not bundle:
        return {'error': 'no app in front'}
    page = {'bundle': bundle, 'app': name, 'name': name}
    if bundle == ARC:
        # the first time, macOS asks whether ThreadIsland may control Arc: leave time to answer
        try:
            p = subprocess.run(['osascript', '-e', ARC_CAPTURE], capture_output=True, text=True, timeout=60)
        except subprocess.TimeoutExpired:
            return {'error': "Arc didn't answer; try again"}
        parts = p.stdout.rstrip('\n').split('\x1f')
        if p.returncode != 0 or len(parts) != 5:
            # saving plain Arc instead would look like a saved tab and only ever open Arc
            return {'error': 'couldn\'t read the Arc tab: ' + (p.stderr.strip() or 'no tab open')
                    + ('. Allow ThreadIsland in System Settings > Privacy & Security > Automation' if '-1743' in p.stderr else '')}
        tab, title, url, space, space_title = parts
        page.update(tab=tab, url=url, space=space, name=title or name, detail=f'{space_title} space')
    return page


def open_page(page):
    if page.get('tab'):
        p = subprocess.run(['osascript', '-', page['tab'], page.get('space') or '', page.get('url') or ''], input=ARC_SELECT,
                           capture_output=True, text=True, timeout=30)
        if p.stdout.strip() == 'ok':
            return None
        if page.get('url'):  # closed since: open it again
            return checked(['open', '-b', ARC, page['url']])
        return p.stderr.strip() or 'tab not found'
    return checked(['open', '-b', page['bundle']])


FAVICONS = f'{HOME}/Library/Caches/ThreadIsland/favicons'
RECENT_PAGES = 8


def favicon(url, key):
    """The site's own icon for a saved tab: its <link rel="icon">, else /favicon.ico. Fetched from the site
    once when you save (no third-party favicon service, which would see every site you save), kept on disk.
    None if there isn't one; the page then shows the browser's icon."""
    if not url.startswith(('http://', 'https://')):
        return None
    headers = {'User-Agent': 'Mozilla/5.0 (Macintosh) ThreadIsland'}
    page_host = urllib.parse.urlsplit(url).hostname

    def allowed(u):
        """The page's own host (you saved it), or a public address: a page's HTML picks the icon URL, and
        mustn't make this fetch reach localhost or your network for it. Checked on every redirect too."""
        host = urllib.parse.urlsplit(u).hostname
        if not host or urllib.parse.urlsplit(u).scheme not in ('http', 'https'):
            return False
        if host == page_host:
            return True
        try:
            ips = {ipaddress.ip_address(a[4][0]) for a in socket.getaddrinfo(host, None)}
        except (OSError, ValueError):
            return False
        return bool(ips) and all(ip.is_global for ip in ips)

    class Checked(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, hdrs, newurl):
            if not allowed(newurl):
                raise urllib.error.URLError(f'redirect to {newurl} not allowed')
            return super().redirect_request(req, fp, code, msg, hdrs, newurl)
    opener = urllib.request.build_opener(Checked)

    def get(u, limit):
        if not allowed(u):
            raise ValueError(f'{u} not allowed')
        with opener.open(urllib.request.Request(u, headers=headers), timeout=4) as resp:
            return resp.read(limit), resp.headers.get_content_type()
    candidates = []
    try:
        html = get(url, 512 * 1024)[0].decode('utf-8', 'replace')
        for tag in re.findall(r'<link\b[^>]*>', html, re.I):
            rel = re.search(r'\brel\s*=\s*["\']?([^"\'>]+)', tag, re.I)
            href = re.search(r'\bhref\s*=\s*["\']?([^"\' >]+)', tag, re.I)
            if rel and href and 'icon' in rel.group(1).lower() and 'mask' not in rel.group(1).lower():
                candidates.append(urllib.parse.urljoin(url, href.group(1)))
    except (OSError, ValueError):
        pass
    candidates.append(urllib.parse.urljoin(url, '/favicon.ico'))
    for u in candidates:
        try:
            body, kind = get(u, 1024 * 1024)
        except (OSError, ValueError):
            continue
        if body and kind.startswith('image/'):
            os.makedirs(FAVICONS, exist_ok=True)
            path = os.path.join(FAVICONS, re.sub(r'[^A-Za-z0-9-]', '', key) + '.' + (kind.split('/')[1].split('+')[0] or 'img'))
            with open(path, 'wb') as fh:
                fh.write(body)
            return path
    return None


def pages_edit(e):
    icon = None
    if e['op'] == 'add' and isinstance(e['page'].get('url'), str) and isinstance(e['page'].get('id'), str):
        icon = favicon(e['page']['url'], e['page']['id'])  # before the lock: the network can be slow
    with edited_state() as state:
        pages = state.setdefault('pages', [])
        if e['op'] == 'add':
            page = {k: v for k, v in e['page'].items()
                    if k in ('id', 'bundle', 'app', 'name', 'tab', 'url', 'space', 'detail') and isinstance(v, str)}
            page.setdefault('id', f'{time.time_ns():x}')  # the app sends one, so it can show the page right away
            if icon:
                page['icon'] = icon
            # the app can't read a page without these; one bad entry would blank the whole list
            if page.get('bundle') and page.get('name') and all(p.get('id') != page['id'] for p in pages):
                pages.append(page)
        elif e['op'] == 'remove':
            # kept under Recently removed, newest first, so it can be pinned back
            recent = state.setdefault('recent_pages', [])
            recent[:0] = [p for p in pages if p.get('id') == e['id']]
            state['pages'] = [p for p in pages if p.get('id') != e['id']]
            for p in recent[RECENT_PAGES:]:
                if p.get('icon', '').startswith(FAVICONS):
                    with contextlib.suppress(OSError):
                        os.remove(p['icon'])
            del recent[RECENT_PAGES:]
        elif e['op'] == 'restore':
            recent = state.setdefault('recent_pages', [])
            pages.extend(p for p in recent if p.get('id') == e['id'] and all(q.get('id') != e['id'] for q in pages))
            state['recent_pages'] = [p for p in recent if p.get('id') != e['id']]


def new_session_terminal():
    """Terminal for a session that isn't open anywhere: the one you were just in (the island never takes
    focus), else whichever is running (Ghostty first), else Ghostty."""
    front = run(['lsappinfo', 'info', '-only', 'name', run(['lsappinfo', 'front']).strip()])
    for app in ('Warp', 'Ghostty'):
        if f'"{app}"' in front:
            return app
    if run(['pgrep', '-x', 'ghostty']):
        return 'Ghostty'
    return 'Warp' if run(['pgrep', '-f', '/Applications/Warp.app/Contents/MacOS/stable$']) else 'Ghostty'


def toml_str(s):
    """A TOML basic string; quotes, backslashes and control characters as \\uXXXX escapes."""
    return '"' + ''.join(c if c not in '"\\' and 0x1f < ord(c) != 0x7f else f'\\u{ord(c):04x}' for c in s) + '"'


def warp_open(cwd, command, key):
    """Open a Warp tab in cwd running command. The URI scheme can't run commands; a Tab Config can, and Warp
    re-reads the file on every open (https://docs.warp.dev/terminal/sessions/tab-configs). A new window
    would also get an empty default tab, so this opens a tab in the front Warp window. One config per
    thread, written atomically, so two quick clicks can't open the same thread twice."""
    folder = f'{HOME}/.warp/tab_configs'
    os.makedirs(folder, exist_ok=True)
    for old in glob.glob(f'{folder}/threadisland*.toml'):  # they show in Warp's + menu; keep a day's worth
        if NOW - os.path.getmtime(old) > 86400:
            os.remove(old)
    name = 'threadisland-' + re.sub(r'[^A-Za-z0-9-]', '', key)[:40]
    with open(f'{folder}/.{name}.tmp', 'w') as fh:
        fh.write(f'name = "ThreadIsland"\n\n[[panes]]\nid = "main"\ntype = "terminal"\n'
                 f'directory = {toml_str(cwd)}\ncommands = [{toml_str(command)}]\n')
    os.replace(f'{folder}/.{name}.tmp', f'{folder}/{name}.toml')
    return checked(['open', f'warp://tab_config/{name}'])


def checked(cmd, stdin=None):
    """Run a jump command; None on success, else what went wrong (shown in the panel)."""
    p = subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=30)
    return None if p.returncode == 0 else (p.stderr.strip() or f'{cmd[0]} exited with {p.returncode}')


def jump(r):
    if r['action'] == 'url':
        return checked(['open', r['arg']])
    if r['action'] == 'focus':
        return checked(['osascript', '-', r['arg']], GHOSTTY_FOCUS)
    if r['action'] == 'tab':
        if new_session_terminal() == 'Warp':
            return warp_open(r['cwd'] or HOME, r['arg'], r['key'])
        return checked(['osascript', '-', r['cwd'] or HOME, r['arg']], GHOSTTY_TAB)
    return None


PR_CACHE = f'{HOME}/Library/Caches/ThreadIsland/prs.json'
PR_URL = re.compile(r'https://github\.com/([\w.-]+)/([\w.-]+)/pull/(\d+)')
PR_TTL = 300  # PR status is fetched at most every 5 min, in one call for all of them


def created_prs(kind, path, seen):
    """PRs a thread created, from its log. seen: what an earlier run found and how far it read, so each
    run reads only what was added since. Claude Code tags a PR it created on the tool result
    (gitOperation.pr, action "created"); Codex logs every shell command with its exit code and output, and
    its GitHub app's calls as McpToolCall items. A PR the thread only mentions or reviews doesn't count."""
    size = os.path.getsize(path)
    if seen.get('size', 0) > size:  # rewritten: read it again
        seen.clear()
    prs, at = seen.setdefault('prs', []), seen.get('offset', 0)

    def found(text):
        urls = [m.group(0) for m in PR_URL.finditer(text)]
        if urls and urls[-1] not in prs:
            prs.append(urls[-1])

    with open(path, 'rb') as fh:
        fh.seek(at)
        carry = b''
        while chunk := fh.read(4 * 1024 * 1024):
            lines = (carry + chunk).split(b'\n')
            carry = lines.pop()  # unfinished; read again next run
            at += len(chunk)
            for line in lines:
                if kind == 'claude':
                    if b'"gitOperation"' in line and b'"action":"created"' in line:
                        pr = ((loads(line).get('toolUseResult') or {}).get('gitOperation') or {}).get('pr') or {}
                        if pr.get('action') == 'created':
                            found(pr.get('url') or '')
                elif b'"CommandExecution"' in line and b'gh pr create' in line:
                    item = (loads(line).get('payload') or {}).get('item') or {}
                    if item.get('exit_code') == 0 and 'gh pr create' in json.dumps(item.get('command')):
                        found(item.get('aggregated_output') or '')
                elif b'"McpToolCall"' in line and b'create_pull_request' in line:
                    item = (loads(line).get('payload') or {}).get('item') or {}
                    if item.get('status') == 'completed' and 'create_pull_request' in (item.get('tool') or ''):
                        found(json.dumps(item.get('result')))
    seen.update(offset=at - len(carry), size=size)
    return prs


def pr_statuses(urls, known):
    """State of each PR from GitHub, one GraphQL call through gh for all of them
    (https://docs.github.com/en/graphql/reference/objects#pullrequest). Merged and closed are final."""
    ask = [u for u in urls if (known.get(u) or {}).get('state') not in ('MERGED', 'CLOSED')]
    gh = next((g for g in ('/opt/homebrew/bin/gh', '/usr/local/bin/gh', '/usr/bin/gh') if os.path.exists(g)), None)
    if not ask or not gh:
        return
    parts = []
    for i, u in enumerate(ask):
        owner, name, number = PR_URL.match(u).groups()
        parts.append(f'p{i}: repository(owner: {json.dumps(owner)}, name: {json.dumps(name)}) {{ pullRequest(number: {number}) '
                     '{ state isDraft reviewDecision createdAt commits(last: 1) { nodes { commit { statusCheckRollup { state } } } } } }')
    out = run([gh, 'api', 'graphql', '-f', 'query={ ' + ' '.join(parts) + ' }'], timeout=15)
    data = (loads(out.encode()) or {}).get('data')
    if not data:
        raise RuntimeError(f'gh api graphql returned no data: {out.strip()[:200] or "no output"}')
    for i, u in enumerate(ask):
        pr = (data.get(f'p{i}') or {}).get('pullRequest')
        if pr:  # null: deleted, or a repo you can't see
            nodes = pr['commits']['nodes']
            checks = ((nodes[0]['commit'].get('statusCheckRollup') or {}).get('state')) if nodes else None
            known[u] = {'state': pr['state'], 'draft': pr['isDraft'], 'review': pr['reviewDecision'],
                        'checks': checks, 'created': epoch(pr['createdAt'])}


def pr_label(u, s):
    status = ('draft' if s['draft'] else 'checks failing' if s['checks'] in ('FAILURE', 'ERROR')
              else 'changes requested' if s['review'] == 'CHANGES_REQUESTED'
              else 'approved' if s['review'] == 'APPROVED' else 'in review')
    return f'#{PR_URL.match(u).group(3)} {status}'


def attach_prs(rows):
    """Mark rows whose thread has open PRs: 'pr' is the label shown, 'pr_since' when the first one opened."""
    os.makedirs(os.path.dirname(PR_CACHE), exist_ok=True)
    try:
        cache = json.load(open(PR_CACHE))
    except (OSError, ValueError):
        cache = {}
    logs, known = cache.get('logs', {}), cache.get('status', {})
    by_row, listed = {}, set()
    for r in rows:
        kind, path = r.pop('log', (None, None))
        if path and os.path.exists(path):
            listed.add(path)
            by_row[r['key']] = created_prs(kind, path, logs.setdefault(path, {}))
    urls = sorted({u for us in by_row.values() for u in us})
    try:
        if NOW - cache.get('fetched', 0) > PR_TTL or any(u not in known for u in urls):
            pr_statuses(urls, known)
            cache['fetched'] = NOW
    except Exception as e:  # noqa: BLE001 - shown in the panel; rows keep the last known status
        ERRORS.append(f'GitHub PRs: {type(e).__name__}: {e}')
    for r in rows:
        open_prs = [u for u in by_row.get(r['key'], []) if (known.get(u) or {}).get('state') == 'OPEN']
        if open_prs:
            r['pr'] = pr_label(open_prs[0], known[open_prs[0]]) + (f' +{len(open_prs) - 1}' if len(open_prs) > 1 else '')
            r['pr_since'] = min(known[u]['created'] for u in open_prs)
    # keep only threads still listed, so the cache doesn't grow forever
    cache.update(logs={p: v for p, v in logs.items() if p in listed}, status={u: known[u] for u in urls if u in known})
    with open(PR_CACHE + '.tmp', 'w') as fh:
        json.dump(cache, fh)
    os.replace(PR_CACHE + '.tmp', PR_CACHE)


STATE = f'{HOME}/Library/Application Support/ThreadIsland/state.json'


@contextlib.contextmanager
def edited_state():
    """Priority's order: 'order' is its keys, top first, so a row you dragged keeps its place.
    Locked, so a refresh pruning it can't undo a drag saved at the same moment; written only if changed."""
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + '.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            state = json.load(open(STATE))
        except (OSError, ValueError):
            state = {}
        state.setdefault('order', [])
        state.pop('removed', None)  # from a removed feature
        before = json.dumps(state, sort_keys=True)
        yield state
        if json.dumps(state, sort_keys=True) != before:
            with open(STATE + '.tmp', 'w') as fh:
                json.dump(state, fh)
            os.replace(STATE + '.tmp', STATE)


def edit(e):
    """Save Priority's order after you drag a row: keys, top first, as you left them."""
    with edited_state() as state:
        state['order'] = [k for k in e['keys'] if isinstance(k, str)]


def sectioned(rows):
    """Positions are learned, so rows never swap on their own:
    Priority holds threads with activity in the last 2 h, in the order their current run of activity began,
    so a thread that becomes active (new or not) joins at the bottom. A thread leaves after 2 h with no
    activity, whatever its state, which is also what ends a run, so its slot can't change while it stays.
    Day sections sort by your last message, which can't change there: a new message makes a thread active,
    and it moves to Priority.
    The order is saved, so a row you drag keeps its place."""
    def hot(r):
        return NOW - r.get('active', 0) < IDLE_OUT
    with edited_state() as state:
        natural = sorted((r for r in rows if hot(r)), key=lambda r: r.get('entered') or r.get('created') or r['ts'])
        # threads keep their slot while in Priority; one that leaves loses it, and any that join (new or back
        # after idle) go below the rest, in the order they began
        keys = {r['key'] for r in natural}
        kept = [k for k in state['order'] if k in keys]
        state['order'] = kept + [r['key'] for r in natural if r['key'] not in set(kept)]
        rank = {k: i for i, k in enumerate(state['order'])}
        priority = sorted(natural, key=lambda r: rank[r['key']])
    # an idle thread with an open PR isn't done: it waits here, oldest PR first, until the PR closes
    prs = sorted((r for r in rows if not hot(r) and r.get('pr')), key=lambda r: r['pr_since'])
    # the 7-day window applies to sort time (your last message), which can be older than a source's file mtime
    recent = sorted((r for r in rows if not hot(r) and not r.get('pr') and r['ts'] >= CUTOFF), key=lambda r: -r['ts'])
    for r in priority:
        r['section'] = 'Priority'
    for r in prs:
        r['section'] = 'Open PRs'
    for r in recent:
        day = datetime.date.fromtimestamp(r['ts'])
        r['section'] = ('Today' if day == TODAY else 'Yesterday' if (TODAY - day).days == 1
                        else day.strftime('%A'))
    return priority + prs + recent


def main():
    if '--jump' in sys.argv:
        try:
            error = jump(json.load(sys.stdin))
        except Exception as e:  # noqa: BLE001 - shown in the panel
            error = f'{type(e).__name__}: {e}'
        json.dump({'error': error}, sys.stdout)
        return

    if '--edit' in sys.argv:
        edit(json.load(sys.stdin))
        return
    if '--page-capture' in sys.argv:
        json.dump(capture_page(), sys.stdout)
        return
    if '--page-edit' in sys.argv:
        pages_edit(json.load(sys.stdin))
        return
    if '--page-open' in sys.argv:
        try:
            error = open_page(json.load(sys.stdin))
        except Exception as e:  # noqa: BLE001 - shown in the panel
            error = f'{type(e).__name__}: {e}'
        json.dump({'error': error}, sys.stdout)
        return

    procs = processes()
    gtty = ghostty_ttys()
    sessions = live_sessions()
    rows = []
    # each source reads private files that an app update can change; report a broken one instead of hiding it
    for name, source in (('Codex', lambda: codex_rows(procs, gtty)), ('Claude app', lambda: claude_desktop_rows(sessions)),
                         ('Claude CLI', lambda: claude_cli_rows(procs, gtty, sessions))):
        try:
            rows += source()
        except Exception as e:  # noqa: BLE001 - any failure here is shown in the panel
            ERRORS.append(f'{name}: {type(e).__name__}: {e}')
    try:
        attach_prs(rows)
    except Exception as e:  # noqa: BLE001 - shown in the panel; the list still shows, without PRs
        ERRORS.append(f'GitHub PRs: {type(e).__name__}: {e}')
    for r in rows:
        r.pop('log', None)
    rows = sectioned(rows)

    for r in rows:
        r['age'] = ago(r['ts'])
    with edited_state() as state:
        pages, recent = state.get('pages', []), state.get('recent_pages', [])
    json.dump({'rows': rows, 'errors': ERRORS, 'pages': pages, 'recent': recent}, sys.stdout)


if __name__ == '__main__':
    main()
